<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="de.utrost.textr.ShareReceiver" android:exported="true" android:label="Textr test receiver">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- Installed only in the test APK; simulates a separate app's document provider. -->
        <provider
            android:name="de.utrost.textr.FixtureProvider"
            android:authorities="de.utrost.textr.test.documents"
            android:exported="true"
            android:grantUriPermissions="true" />
    </application>
</manifest>
